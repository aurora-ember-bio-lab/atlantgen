# Postgres connection used by the API (Atlas schema orchestrator) and the worker
DATABASE_URL=postgres://aura:aura@localhost:5432/aura_amber?sslmode=disable

# Redis (BullMQ job queue) used by the worker
REDIS_HOST=localhost
REDIS_PORT=6379

# Worker's HTTP shim (internal/migration/worker_client.go -> worker/src/server.ts)
WORKER_URL=http://localhost:8090
WORKER_HTTP_PORT=8090
NEXT_PUBLIC_API_URL=http://localhost:8080

# Stripe (billing / marketplace) — restricted API key recommended
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PLAN_BASIC=

# GitHub App (billing / marketplace) — see github-app/manifest.yml
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
