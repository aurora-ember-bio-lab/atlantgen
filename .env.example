# Postgres connection (API + Worker)
DATABASE_URL=postgres://user:password@localhost:5432/atlantgen?sslmode=disable

# Redis (BullMQ job queue)
REDIS_HOST=localhost
REDIS_PORT=6379

# Worker HTTP endpoint
WORKER_URL=http://localhost:8090
WORKER_HTTP_PORT=8090

# API public URL
NEXT_PUBLIC_API_URL=http://localhost:8080

# Stripe (optional — billing feature)
STRIPE_SECRET_KEY=sk_test_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE

# WooCommerce (optional — store connector)
WOOCOMMERCE_BASE_URL=https://your-store.com
WOOCOMMERCE_CONSUMER_KEY=ck_REPLACE
WOOCOMMERCE_CONSUMER_SECRET=cs_REPLACE

# WordPress (optional — store connector)
WORDPRESS_BASE_URL=https://your-site.com
WORDPRESS_USERNAME=your_username
WORDPRESS_APP_PASSWORD=your_app_password
